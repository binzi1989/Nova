<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NovaDesktop</RootNamespace>
    <AssemblyName>Nova.AgentOS</AssemblyName>
    <Version>1.0.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\NovaDesktop\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\NovaDesktop\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="GHSoftware.WordDocTextExtractor" Version="1.0.4" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>
</Project>
