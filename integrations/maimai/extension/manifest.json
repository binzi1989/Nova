{
  "manifest_version": 3,
  "name": "NOVA 脉脉安全采集",
  "version": "1.0.0",
  "description": "仅在用户点击时读取当前脉脉页面的可见信息，并保存到 NOVA 本地加密仓。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "保存当前脉脉页面到 NOVA",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
