<Window x:Class="NovaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:NovaDesktop.Controls"
        mc:Ignorable="d"
        Title="NOVA"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <RadialGradientBrush x:Key="CoreGradient" GradientOrigin=".38,.3" Center=".45,.4" RadiusX=".68" RadiusY=".68">
            <GradientStop Color="#F4FAFF" Offset="0"/>
            <GradientStop Color="#62E6FF" Offset=".24"/>
            <GradientStop Color="#748BFF" Offset=".62"/>
            <GradientStop Color="#201A5A" Offset="1"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="SpectrumBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#62E6FF" Offset="0"/>
            <GradientStop Color="#748BFF" Offset=".55"/>
            <GradientStop Color="#B17CFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#AAB3C7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1B2230"/>
                                <Setter Property="Foreground" Value="#F5F7FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#263044"/>
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.08" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.08" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#A5261A"/>
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value=".82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="0"
                                Padding="11,10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2,0,0,0"
                                CornerRadius="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0F1724"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#314765"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#121D2C"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NodeCard" TargetType="Border">
            <Setter Property="Background" Value="#E60D1422"/>
            <Setter Property="BorderBrush" Value="#2B3A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity=".2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="CoreBreathing" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CoreVisual"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                             From=".99" To="1.018" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CoreVisual"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                             From=".99" To="1.018" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CoreGlow"
                             Storyboard.TargetProperty="Opacity"
                             From=".28" To=".46" Duration="0:0:2.4"/>
        </Storyboard>

        <Storyboard x:Key="OrbitAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OuterOrbit"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:18"/>
            <DoubleAnimation Storyboard.TargetName="InnerOrbit"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:12"/>
        </Storyboard>

        <Storyboard x:Key="FlowAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FlowDash"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="18" To="0" Duration="0:0:1.35"/>
        </Storyboard>
    </Window.Resources>

    <Border BorderBrush="#1C2940" BorderThickness="1">
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="#080B11"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Native title bar -->
            <Grid Grid.Row="0" Background="#F2070A12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Ellipse Fill="{StaticResource SpectrumBrush}" Opacity=".22"/>
                        <Ellipse Width="12" Height="12" Fill="{StaticResource CoreGradient}"/>
                        <Ellipse Width="4" Height="4" Fill="White"/>
                    </Grid>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="13"
                               Text="NOVA AgentOS"/>
                    <Border Margin="9,0,0,0"
                            Padding="7,2"
                            Background="#121C2D"
                            BorderBrush="#2B4164"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanBrush}"
                                   Text="LOCAL"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip="{Binding HumanGuidanceDetail}">
                    <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#69748A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveConfigured}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="#AAB5C7"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Text="{Binding ShellStatus}"/>
                    <Border Width="1" Height="12" Background="#303647" Margin="11,0"/>
                    <TextBlock Foreground="{StaticResource CyanBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="{Binding HumanStatusLabel}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}"
                            Click="QuickStart_Click"
                            ToolTip="快速开始：四步完成第一次真实执行"
                            AutomationProperties.Name="快速开始">
                        <Grid Width="17" Height="17">
                            <Ellipse Margin="1"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.2"/>
                            <Path Data="M6.2,6.1 C6.35,4.75 7.25,4 8.65,4 C10.05,4 11,4.82 11,6.05 C11,7.15 10.3,7.7 9.4,8.25 C8.65,8.72 8.3,9.18 8.3,10 M8.3,12.65 L8.31,12.65"
                                  Stroke="#75F0FF"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WindowButton}"
                            Click="AgentOs_Click"
                            ToolTip="AgentOS 控制中心"
                            AutomationProperties.Name="AgentOS 控制中心">
                        <Grid Width="17" Height="17">
                            <Ellipse Margin="1"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.2"/>
                            <Ellipse Width="7" Height="7"
                                     Stroke="#75F0FF"
                                     StrokeThickness="1.25"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#75F0FF"/>
                            <Path Data="M8.5,0 V3 M8.5,14 V17 M0,8.5 H3 M14,8.5 H17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WindowButton}"
                            Click="MoreTools_Click"
                            ToolTip="工具与能力"
                            AutomationProperties.Name="工具与能力">
                        <Path Width="15"
                              Height="15"
                              Data="M1,1 H6 V6 H1 Z M9,1 H14 V6 H9 Z M1,9 H6 V14 H1 Z M9,9 H14 V14 H9 Z"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"/>
                        <Button.ContextMenu>
                            <ContextMenu Background="#111722"
                                         BorderBrush="#303B50"
                                         BorderThickness="1"
                                         Padding="5"
                                         HasDropShadow="True">
                                <MenuItem Header="专业工程中心"
                                          Foreground="#E7ECF5"
                                          Background="Transparent"
                                          Padding="12,8"
                                          Click="Engineering_Click"/>
                                <MenuItem Header="MCP 与 Skills"
                                          Foreground="#E7ECF5"
                                          Background="Transparent"
                                          Padding="12,8"
                                          Click="Extensions_Click"/>
                                <MenuItem Header="计划任务"
                                          Foreground="#E7ECF5"
                                          Background="Transparent"
                                          Padding="12,8"
                                          Click="Schedules_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource WindowButton}"
                            Click="Settings_Click"
                            ToolTip="模型与运行时设置"
                            AutomationProperties.Name="设置">
                        <Grid Width="16" Height="16">
                            <Path Data="M1,4 H15 M1,8 H15 M1,12 H15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                            <Ellipse Width="3.5" Height="3.5" Margin="3.5,0,0,8"
                                     HorizontalAlignment="Left"
                                     Fill="#080A0F"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.1"/>
                            <Ellipse Width="3.5" Height="3.5" Margin="0,0,3.5,0"
                                     HorizontalAlignment="Right"
                                     Fill="#080A0F"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.1"/>
                            <Ellipse Width="3.5" Height="3.5" Margin="5.5,8,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="#080A0F"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.1"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WindowButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化"
                            AutomationProperties.Name="最小化">
                        <Path Width="13"
                              Data="M1,7 H12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButton}"
                            Click="Maximize_Click"
                            ToolTip="最大化"
                            AutomationProperties.Name="最大化">
                        <Path x:Name="MaximizeGlyph"
                              Width="13"
                              Height="13"
                              Data="M1.5,1.5 H11.5 V11.5 H1.5 Z"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.25"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}"
                            Click="Close_Click"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭">
                        <Path Width="13"
                              Height="13"
                              Data="M1.5,1.5 L11.5,11.5 M11.5,1.5 L1.5,11.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftRailColumn" Width="242"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RightRailColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left mission rail -->
                <Border Grid.Column="0"
                        Background="#0A0E15"
                        BorderBrush="#222B39"
                        BorderThickness="0,1,1,0">
                    <Grid Margin="14,17,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Height="46"
                                Command="{Binding NewTaskCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#071014" Text="&#xE710;" Margin="0,0,10,0"/>
                                <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="#071014" Text="新建任务"/>
                                <TextBlock Margin="80,0,0,0" Foreground="#5A7479" Text="Ctrl N" FontSize="10"/>
                            </StackPanel>
                        </Button>

                        <Grid Grid.Row="1" Margin="3,20,3,9">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#8392AA"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding TaskLibraryTitle}"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Foreground="#55647C"
                                           FontSize="9.5"
                                           Text="{Binding VisibleTaskCount}"/>
                                <Button Height="24"
                                        Padding="7,2"
                                        Command="{Binding ToggleArchivedTasksCommand}"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="在当前任务与归档任务之间切换">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   Text="&#xE7B8;"/>
                                        <TextBlock Margin="5,0,0,0"
                                                   FontSize="8.5"
                                                   Text="{Binding TaskArchiveToggleLabel}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding TaskView}"
                                     SelectedItem="{Binding SelectedTask}"
                                     IsHitTestVisible="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"
                                     Focusable="False"
                                     ItemContainerStyle="{StaticResource TaskListItem}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="9" Height="16" VerticalAlignment="Top" Margin="0,3,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource TaskStateBrush}}"/>
                                                <Ellipse Width="7" Height="7" Stroke="{Binding State, Converter={StaticResource TaskStateBrush}}" Opacity=".25">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform ScaleX="1.8" ScaleY="1.8" CenterX="3.5" CenterY="3.5"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="0,5,0,0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{Binding Stage}" TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,8,0,0">
                                                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Maximum="100"/>
                                                </Grid>
                                                <TextBlock Margin="0,5,0,0" FontSize="9" Foreground="#596983" Text="{Binding Elapsed}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="2" VerticalAlignment="Top">
                                                <Button Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        Command="{Binding DataContext.ArchiveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        ToolTip="归档任务"
                                                        Visibility="{Binding IsArchived, Converter={StaticResource InverseBooleanToVisibility}}">
                                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                                               FontSize="10.5"
                                                               Foreground="#8090A8"
                                                               Text="&#xE7B8;"/>
                                                </Button>
                                                <Button Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        Command="{Binding DataContext.RestoreTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        ToolTip="恢复到任务空间"
                                                        Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibility}}">
                                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource CyanBrush}"
                                                               Text="&#xE777;"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Padding="18"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Visibility="{Binding HasVisibleTasks, Converter={StaticResource InverseBooleanToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="38"
                                            Height="38"
                                            Background="#101824"
                                            BorderThickness="0"
                                            CornerRadius="4">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   FontSize="15"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE7B8;"/>
                                    </Border>
                                    <TextBlock Margin="0,13,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="{Binding TaskSpaceEmptyTitle}"/>
                                    <TextBlock Margin="0,6,0,0"
                                               MaxWidth="175"
                                               FontSize="9"
                                               LineHeight="14"
                                               Foreground="#7888A1"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding TaskSpaceEmptyDetail}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Grid.Row="3" Style="{StaticResource GhostButton}" Padding="0" Margin="0,12,0,0"
                                Click="Workspace_Click" ToolTip="切换本地工作区">
                            <Border Background="#0D131D"
                                    BorderBrush="#263142"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0"
                                    Padding="13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" Background="#151D29" CornerRadius="4">
                                        <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource VioletBrush}" Text="&#xE77B;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="本地工作区"/>
                                        <TextBlock Width="165" FontSize="9.5" Foreground="#8290A7" Text="{Binding WorkspaceRoot}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Width="165" Margin="0,3,0,0" FontSize="8.5" Foreground="#6785A5"
                                                   Text="{Binding WorkspaceSummary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource IconText}" FontSize="11" Text="&#xE70D;"/>
                                </Grid>
                            </Border>
                        </Button>

                        <Button Grid.Row="4"
                                Height="36"
                                Margin="0,8,0,0"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Center"
                                Click="Cognition_Click"
                                ToolTip="打开工作效率总结与本地知识图谱">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource VioletBrush}" Text="&#xE950;" Margin="0,0,8,0"/>
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="效率与认知中心"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="5"
                                Height="36"
                                Margin="0,8,0,0"
                                Command="{Binding ResumeSelectedCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Center"
                                ToolTip="从持久化目标快照重新建立执行上下文">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE72C;" Margin="0,0,8,0"/>
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="恢复所选任务"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Center command stage -->
                <Grid Grid.Column="1" Margin="20,15,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="{Binding HumanGuidanceDetail}">
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontWeight="SemiBold"
                                       Text="{Binding HumanStatusLabel}"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="25"
                                           Style="{StaticResource DisplayTitleText}"
                                           Text="{Binding SelectedTask.Title, TargetNullValue=新任务}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding HumanGuidanceTitle}"
                                           TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}">
                            <Border Background="#101923"
                                    BorderBrush="#2A4250"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    MaxWidth="235"
                                    Padding="11,7"
                                    Margin="0,0,8,0"
                                    ToolTip="这里只统计真实模型请求与工具调用；连接和状态动画不消耗预算">
                                <TextBlock FontSize="10"
                                           Foreground="#8FE7EE"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding BudgetStatusLabel}"/>
                            </Border>
                            <Border Background="#121823" BorderBrush="#263044" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}" Margin="0,0,7,0"/>
                                    <TextBlock FontSize="10.5" Foreground="#BBC4D9">
                                        <Run Text="{Binding ActiveAgentCount, Mode=OneWay}"/>
                                        <Run Text=" 个执行单元"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding PauseCommand}" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE769;" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding PauseLabel}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" ToolTip="停止任务">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE71A;"/>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding ResumeSelectedCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="15,9"
                                Visibility="{Binding CanResumeSelected, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="#071014"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="从这里继续"/>
                                <TextBlock Margin="8,0,0,0"
                                           FontFamily="Segoe Fluent Icons"
                                           Foreground="#071014"
                                           FontSize="11"
                                           Text="&#xE72A;"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="12,9"
                            Background="#C9111720"
                            BorderBrush="#29364B"
                            BorderThickness="1"
                            CornerRadius="11"
                            Visibility="{Binding IsLiveConfigured, Converter={StaticResource InverseBooleanToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource GhostButton}"
                                    Padding="7,5"
                                    Click="Workspace_Click"
                                    ToolTip="选择任务根目录">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" Background="#1A2634" CornerRadius="6">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource CyanBrush}" Text="&#xE8B7;"/>
                                    </Border>
                                    <StackPanel Margin="7,0,0,0">
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold" Text="1 选择工作区"/>
                                        <TextBlock Width="150" FontSize="8.5" Foreground="#718097" Text="{Binding WorkspaceSummary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#46536A" Text="›"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Padding="7,5"
                                    Click="Settings_Click"
                                    ToolTip="连接 OpenAI、DeepSeek 或 Kimi">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" Background="#202036" CornerRadius="6">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource VioletBrush}" Text="&#xE950;"/>
                                    </Border>
                                    <StackPanel Margin="7,0,0,0">
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold" Text="2 连接模型"/>
                                        <TextBlock Width="145" FontSize="8.5" Foreground="#718097" Text="{Binding ExecutionReadinessTitle}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#46536A" Text="›"/>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock FontSize="9.5" FontWeight="SemiBold" Text="3 描述目标并执行"/>
                                <TextBlock FontSize="8.5" Foreground="#718097" Text="NOVA 将读取、修改并验证"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}"
                                           Text="{Binding ExecutionReadinessTitle}"/>
                                <TextBlock Margin="0,3,0,0" MaxWidth="340" TextAlignment="Right" FontSize="8.5" Foreground="#8391A8"
                                           Text="{Binding ExecutionReadinessDetail}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Human-readable execution guidance. Technical state stays available on demand. -->
                    <Border Grid.Row="2"
                            Margin="0,11,0,0"
                            Padding="13,9"
                            Background="#F00C1524"
                            BorderBrush="#2D4263"
                            BorderThickness="1"
                            CornerRadius="11"
                            Effect="{StaticResource ControlDepthEffect}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Margin="0,0,11,0"
                                    Background="#172A44"
                                    BorderBrush="#36577F"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock Style="{StaticResource IconText}"
                                           FontSize="13"
                                           Foreground="{StaticResource GreenBrush}"
                                           Text="&#xE73E;"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#E8EEF8"
                                           Text="{Binding HumanGuidanceTitle}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="#90A0B7"
                                           Text="{Binding HumanGuidanceDetail}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Margin="16,0,0,0"
                                    Padding="9,5"
                                    VerticalAlignment="Center"
                                    Background="#14243A"
                                    BorderBrush="#304B70"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ToolTip="{Binding BudgetStatusLabel}">
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource GreenBrush}"
                                           Text="{Binding HumanStatusLabel}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,11,0,8" MinHeight="410" Visibility="Collapsed">
                        <Border Background="#560A0E16" BorderBrush="#202637" BorderThickness="1" CornerRadius="18">
                            <Grid ClipToBounds="True">
                                <Grid.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Opacity=".23">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Transparent">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#283044" Thickness=".5"/>
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="26,0" EndPoint="26,26"/>
                                                        <LineGeometry StartPoint="0,26" EndPoint="26,26"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.Background>

                                <Canvas x:Name="MissionCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Path x:Name="FlowDash"
                                          Canvas.Left="140"
                                          Canvas.Top="87"
                                          Width="610"
                                          Height="295"
                                          Data="M 24,126 C 135,35 190,35 282,126 C 378,222 430,225 564,125"
                                          Stretch="Fill"
                                          Stroke="#5575F0FF"
                                          StrokeThickness="1.4"
                                          StrokeDashArray="4 8"
                                          StrokeLineJoin="Round"/>
                                </Canvas>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="1.65*"/>
                                        <ColumnDefinition Width="1.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left nodes -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="25,0,8,0">
                                        <Border x:Name="PlanNode" Style="{StaticResource NodeCard}" Margin="0,0,0,42">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="27" Height="27" Background="#20283A" CornerRadius="8">
                                                    <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource VioletBrush}" FontSize="13" Text="&#xE9D2;"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="指挥官"/>
                                                    <TextBlock FontSize="9.5" Foreground="#697187" Text="计划与编排"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="ResearchNode" Style="{StaticResource NodeCard}" Margin="17,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="27" Height="27" Background="#182A31" CornerRadius="8">
                                                    <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource CyanBrush}" FontSize="13" Text="&#xE721;"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="研究员 × 3"/>
                                                    <TextBlock FontSize="9.5" Foreground="#697187" Text="并行市场扫描"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Intelligence core -->
                                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Height="320">
                                        <Ellipse x:Name="CoreGlow" Width="265" Height="265" Opacity=".35">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#6075F0FF" Offset="0"/>
                                                    <GradientStop Color="#0075F0FF" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <BlurEffect Radius="38"/>
                                            </Ellipse.Effect>
                                        </Ellipse>

                                        <Ellipse x:Name="OuterOrbit"
                                                 Width="282"
                                                 Height="282"
                                                 Stroke="#2E8CA5C9"
                                                 StrokeThickness="1"
                                                 StrokeDashArray="2 8"
                                                 RenderTransformOrigin=".5,.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="InnerOrbit"
                                                 Width="224"
                                                 Height="224"
                                                 Stroke="#3CBDA8FF"
                                                 StrokeThickness="1"
                                                 StrokeDashArray="10 5 2 8"
                                                 RenderTransformOrigin=".5,.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>

                                        <Grid x:Name="CoreVisual" Width="142" Height="142" RenderTransformOrigin=".5,.5" CacheMode="BitmapCache">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform/>
                                                    <RotateTransform/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <Ellipse Fill="{StaticResource CoreGradient}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#75F0FF" BlurRadius="30" ShadowDepth="0" Opacity=".65"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Margin="11" Stroke="#BFFFFFFF" StrokeThickness="1" Opacity=".62"/>
                                            <Ellipse Margin="29">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush Center=".36,.3" GradientOrigin=".32,.26">
                                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                        <GradientStop Color="#B8D5FFFF" Offset=".22"/>
                                                        <GradientStop Color="#3D567DFF" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Path Data="M 35,78 C 56,36 89,34 108,64 C 124,91 98,113 69,108 C 47,104 29,96 35,78 Z"
                                                  Fill="#35FFFFFF"
                                                  Stretch="Fill"
                                                  Margin="17,19,22,17"/>
                                        </Grid>

                                        <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" HorizontalAlignment="Left" Margin="25,0,0,78">
                                            <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#75F0FF"/></Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource VioletBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,45"/>
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,53,21,0"/>

                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-2">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource CyanBrush}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding HumanStatusLabel}"/>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Width="290"
                                                       Margin="0,6,0,0"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="#AAB3C8"
                                                       Text="{Binding HumanGuidanceTitle}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Right nodes -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,25,0">
                                        <Border x:Name="CreateNode" Style="{StaticResource NodeCard}" Margin="0,0,17,42">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="27" Height="27" Background="#2B2036" CornerRadius="8">
                                                    <TextBlock Style="{StaticResource IconText}" Foreground="#E3A8FF" FontSize="13" Text="&#xE790;"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="创意总监"/>
                                                    <TextBlock FontSize="9.5" Foreground="#697187" Text="机会与体验"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="ReviewNode" Style="{StaticResource NodeCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="27" Height="27" Background="#183029" CornerRadius="8">
                                                    <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource GreenBrush}" FontSize="13" Text="&#xE73E;"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="审查官"/>
                                                    <TextBlock FontSize="9.5" Foreground="#697187" Text="核验与交付"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Approval card -->
                                <Border VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"
                                        MaxWidth="760"
                                        MaxHeight="390"
                                        Margin="16,0,16,18"
                                        Padding="18"
                                        Background="#FA101815"
                                        BorderBrush="#856FAF9D"
                                        BorderThickness="1"
                                        CornerRadius="19"
                                        Visibility="{Binding IsApprovalVisible, Converter={StaticResource BooleanToVisibility}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="38" ShadowDepth="5" Opacity=".46" Color="#000000"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#1C332C" CornerRadius="11" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource CyanBrush}" Text="&#xE72E;"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                            <TextBlock Margin="0,0,0,3"
                                                       FontSize="8.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CyanBrush}"
                                                       Text="和你确认一下"/>
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding ApprovalTitle}"/>
                                            <ScrollViewer MaxHeight="92"
                                                          Margin="0,5,0,0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="True">
                                                <TextBlock Padding="0,0,8,0"
                                                           FontSize="9.5"
                                                           LineHeight="15"
                                                           Foreground="#8992A8"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding ApprovalDescription}"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Padding="8,4"
                                                VerticalAlignment="Top"
                                                Background="#242B22"
                                                CornerRadius="6"
                                                Visibility="{Binding IsApprovalPreviewVisible, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFC470"
                                                       Text="{Binding ApprovalStats}"/>
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                MinHeight="96"
                                                MaxHeight="150"
                                                Margin="0,13,0,0"
                                                Background="#090C12"
                                                BorderBrush="#303A4F"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Visibility="{Binding IsApprovalPreviewVisible, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBox Margin="11"
                                                     IsReadOnly="True"
                                                     Background="Transparent"
                                                     Foreground="#B8C3D6"
                                                     BorderThickness="0"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     FontSize="9.5"
                                                     Text="{Binding ApprovalPreview, Mode=OneWay}"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                        <Grid Grid.Row="2"
                                              Grid.ColumnSpan="3"
                                              Margin="0,13,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock FontSize="8.8"
                                                       Foreground="#81968E"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding ApprovalSafetyNote}"/>
                                            <StackPanel Grid.Row="1"
                                                        Margin="0,10,0,0"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Command="{Binding RejectCommand}"
                                                        Style="{StaticResource GhostButton}"
                                                        Content="{Binding ApprovalRejectLabel}"
                                                        FontSize="10.5"
                                                        Margin="0,0,5,0"/>
                                                <Button Command="{Binding ApproveCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding ApprovalAllowLabel}"
                                                        FontSize="10.5"
                                                        Margin="0,0,5,0"
                                                        Padding="12,7"/>
                                                <Button Command="{Binding ApproveForRunCommand}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Content="{Binding ApprovalTrustLabel}"
                                                        FontSize="10.5"
                                                        Padding="12,7"
                                                        Visibility="{Binding IsApprovalTrustVisible, Converter={StaticResource BooleanToVisibility}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>

                    <controls:ConversationStage Grid.Row="3"/>

                    <!-- Composer -->
                    <Border Grid.Row="4"
                            Margin="0"
                            Background="#0B1018"
                            BorderBrush="#273142"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0"
                            Padding="16,13,16,14"
                            AllowDrop="True"
                            DragOver="Composer_DragOver"
                            Drop="Composer_Drop"
                            >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="0,0,0,10"
                                    Padding="10,7"
                                    HorizontalAlignment="Left"
                                    Background="#18313A"
                                    BorderBrush="#3C6872"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasSelectedConversationChoice, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"
                                               Text="已选择"/>
                                    <TextBlock Margin="8,0,0,0"
                                               MaxWidth="430"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#E7F1F4"
                                               Text="{Binding SelectedConversationChoice}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Margin="8,0,0,0"
                                            Padding="4,1"
                                            Command="{Binding ClearConversationChoiceCommand}"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="保留输入内容，只移除选择标签">
                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                   FontSize="9"
                                                   Text="&#xE711;"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          Margin="0,0,0,9"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasPendingAttachments, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,0"
                                                    Padding="7,6"
                                                    MinWidth="150"
                                                    MaxWidth="245"
                                                    Background="#17222F"
                                                    BorderBrush="#385068"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30"
                                                            Height="30"
                                                            Background="#213344"
                                                            CornerRadius="7">
                                                        <Grid>
                                                            <Image Margin="2"
                                                                   Source="{Binding LocalPath}"
                                                                   Stretch="UniformToFill"
                                                                   Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibility}}"/>
                                                            <TextBlock Style="{StaticResource IconText}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource CyanBrush}"
                                                                       Text="&#xE8A5;"
                                                                       Visibility="{Binding IsImage, Converter={StaticResource InverseBooleanToVisibility}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,6,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E5EBF4"
                                                                   Text="{Binding FileName}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="8.5"
                                                                   Foreground="#718097">
                                                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding SizeLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Padding="5"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"
                                                            ToolTip="移除附件">
                                                        <TextBlock FontFamily="Segoe Fluent Icons"
                                                                   FontSize="9"
                                                                   Text="&#xE711;"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBox x:Name="PromptBox"
                                     Grid.Row="2"
                                     MinHeight="56"
                                     MaxHeight="112"
                                     Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
                                     FontSize="14.5"
                                     FontWeight="Medium"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="PromptBox_PreviewKeyDown"
                                     CaretBrush="{StaticResource CyanBrush}"/>
                            <Grid Grid.Row="3" Margin="0,9,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="8,6"
                                            Click="Attachment_Click"
                                            ToolTip="{Binding AttachmentSummary}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="13"
                                                  Height="13"
                                                  Data="M11.8,5.1 L6.2,10.7 C4.8,12.1 2.6,12.1 1.3,10.8 C0,9.5 0,7.3 1.4,5.9 L7.2,0.1 C8.1,-0.8 9.6,-0.8 10.5,0.1 C11.4,1 11.4,2.5 10.5,3.4 L5,8.9 C4.5,9.4 3.7,9.4 3.2,8.9 C2.7,8.4 2.7,7.6 3.2,7.1 L8.1,2.2"
                                                  Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.25"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stretch="Uniform"/>
                                            <TextBlock Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="9.5"
                                                       Text="附件"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Padding="7"
                                            IsEnabled="False"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="语音输入将在下一版本开放">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE720;"/>
                                    </Button>
                                    <Button Command="{Binding UseSuggestionCommand}" Style="{StaticResource GhostButton}" Padding="7" ToolTip="使用示例任务">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE945;"/>
                                    </Button>
                                    <Border Width="1" Height="17" Background="#303849" Margin="7,0,10,0"/>
                                    <TextBlock VerticalAlignment="Center" Foreground="#596278" FontSize="9.5" Text="Enter 发送 · Shift+Enter 换行"/>
                                    <Border Margin="10,0,0,0" Padding="7,3" Background="#121D25" CornerRadius="6">
                                        <TextBlock VerticalAlignment="Center" Foreground="#6EAFA9" FontSize="8.8"
                                                   MaxWidth="170" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ConversationRoundLabel}"/>
                                    </Border>
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Click="Submit_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="#071014" FontSize="11.5" FontWeight="Bold" Text="{Binding SubmitActionLabel}"/>
                                        <TextBlock Margin="8,0,0,0" FontFamily="Segoe Fluent Icons" Foreground="#071014" FontSize="12" Text="&#xE72A;"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right live trace -->
                <Border x:Name="RightTrace"
                        Grid.Column="2"
                        Width="292"
                        Background="#090D13"
                        BorderBrush="#222B39"
                        BorderThickness="1,1,0,0"
                        Visibility="{Binding IsTraceVisible, Converter={StaticResource BooleanToVisibility}}">
                    <Grid Margin="18,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="行动脉络"/>
                                <TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#697187" Text="可观测 · 可暂停 · 可回放"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="#5E687D" FontSize="10" Text="{Binding RunTime}"/>
                                <Ellipse Width="5" Height="5" Fill="{StaticResource CyanBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="Transparent"
                                BorderBrush="#222B39"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0"
                                Padding="0,14,0,13"
                                Margin="0,4,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock FontSize="9.5" Foreground="#6D768B" Text="整体进度"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource CyanBrush}" Text="{Binding OverallProgress, StringFormat={}{0:0}%}"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Margin="0,9,0,0" Height="3" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" Style="{StaticResource ThinProgress}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Height="116"
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="#0F151E"
                                BorderBrush="#243044"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#BDA8FF" Text="&#xE8BD;"/>
                                        <TextBlock Margin="7,0,0,0" FontSize="9.5" FontWeight="SemiBold" Text="连续对话"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="8.5" Foreground="#657289"
                                               Text="{Binding ConversationRoundLabel}"/>
                                </Grid>
                                <ListBox Grid.Row="1"
                                         Margin="0,7,0,0"
                                         ItemsSource="{Binding ConversationTurns}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,5"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="8.8" FontWeight="SemiBold" Foreground="#75F0FF" Text="{Binding Speaker}"/>
                                                <TextBlock Grid.Column="1" FontSize="8.8" Foreground="#8794A9"
                                                           Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="7.8"
                                                           Foreground="#4F5B70" Text="{Binding TimeLabel}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Activity}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     From="8" To="0" Duration="0:0:0.24">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Line X1="6" Y1="14" X2="6" Y2="62" Stroke="#252C3B" StrokeThickness="1"/>
                                            <Ellipse Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,5,0,0"
                                                     Fill="{Binding Kind, Converter={StaticResource ActivityKindBrush}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="10" Foreground="{Binding Kind, Converter={StaticResource ActivityKindBrush}}" Text="{Binding Agent}"/>
                                                <TextBlock Margin="7,0,0,0" FontSize="10.5" FontWeight="SemiBold" Text="{Binding Action}"/>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" FontSize="9.5" LineHeight="15" Foreground="#747D92" TextWrapping="Wrap" Text="{Binding Detail}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="8.5" Foreground="#4F576A" Text="{Binding Time}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2"
                              Margin="4,20"
                              Visibility="{Binding HasActivity, Converter={StaticResource InverseBooleanToVisibility}}">
                            <StackPanel Width="205"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                    <Ellipse Stroke="Transparent" StrokeThickness="0"/>
                                    <Ellipse Width="22" Height="22" Fill="#121A26"/>
                                    <Path Width="10" Height="10"
                                          Data="M1,5 H9 M6,2 L9,5 L6,8"
                                          Fill="Transparent"
                                          Stroke="#75F0FF"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                </Grid>
                                <TextBlock Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="等待下一次执行"/>
                                <TextBlock Margin="0,7,0,0"
                                           TextAlignment="Center"
                                           FontSize="9.5"
                                           LineHeight="15"
                                           Foreground="#66728A"
                                           TextWrapping="Wrap"
                                           Text="提交目标后，Agent 调度、工具调用和验证证据会实时出现在这里。"/>
                                <Button Margin="0,14,0,0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding NewTaskCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Padding="10,6"
                                        Content="新建目标"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Height="126"
                                Margin="0,9,0,0"
                                Padding="11"
                                Background="#111722"
                                BorderBrush="#28344A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource CyanBrush}" Margin="0,0,7,0"/>
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" Text="实时回答"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="8.5" Foreground="#58647A" Text="STREAM"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                    <TextBlock FontSize="9.5"
                                               LineHeight="15"
                                               Foreground="#A7B2C8"
                                               TextWrapping="Wrap"
                                               Text="{Binding StreamingText}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <Grid Margin="0,0,0,9">
                                <TextBlock FontSize="10" Foreground="#737B90" FontWeight="SemiBold" Text="成果"/>
                                <Button HorizontalAlignment="Right"
                                        Padding="7,3"
                                        Command="{Binding ShowDeliveryCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Visibility="{Binding HasArtifacts, Converter={StaticResource BooleanToVisibility}}"
                                        ToolTip="打开交付工作台">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="9" Foreground="{StaticResource CyanBrush}" Text="{Binding Artifacts.Count}"/>
                                        <TextBlock Margin="5,0,0,0" FontSize="9" Foreground="#8490A6" Text="打开交付"/>
                                        <Path Margin="6,0,0,0"
                                              Width="7"
                                              Height="7"
                                              Data="M1,1 L6,3.5 L1,6"
                                              Fill="Transparent"
                                              Stroke="{StaticResource CyanBrush}"
                                              StrokeThickness="1.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Artifacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111620" BorderBrush="#20293A" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="29" Height="29" Background="#1A2230" CornerRadius="7">
                                                    <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding Title}"/>
                                                    <TextBlock Margin="0,3,0,0" FontSize="8.8" Foreground="#697287" Text="{Binding Subtitle}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource IconText}" FontSize="10" Text="&#xE72A;"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#0F131C" BorderBrush="#1E2533" BorderThickness="1" CornerRadius="9" Padding="10"
                                    Visibility="{Binding HasArtifacts, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource GreenBrush}" FontSize="12" Text="&#xE73E;"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="9.5" Foreground="#8490A6" Text="成果已通过本地完整性检查"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Seamless delivery workspace -->
                <Grid Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Panel.ZIndex="20"
                      RenderTransformOrigin=".5,.5">
                    <Grid.RenderTransform>
                        <TranslateTransform X="34"/>
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeliveryVisible}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0"
                                                                 To="1"
                                                                 Duration="0:0:0.14">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="34"
                                                                 To="0"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0"
                                                                 Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="22"
                                                                 Duration="0:0:0.13">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.Background>
                        <RadialGradientBrush Center=".7,.18"
                                             GradientOrigin=".72,.15"
                                             RadiusX=".82"
                                             RadiusY=".94">
                            <GradientStop Color="#17233B" Offset="0"/>
                            <GradientStop Color="#0B0E15" Offset=".42"/>
                            <GradientStop Color="#080A0F" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>

                    <Grid Margin="28,20,28,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Padding="8,3"
                                            Background="#16342E"
                                            BorderBrush="#356BE5A9"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0"/>
                                            <TextBlock FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource GreenBrush}"
                                                       Text="已交付"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="#7F8B9E"
                                               Text="结果、文件与验证已经收好"/>
                                </StackPanel>
                                <TextBlock Margin="0,9,0,0"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           Text="本轮交付"/>
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="10.5"
                                           Foreground="#8490A6">
                                    <Run Text="{Binding SelectedTask.Title, Mode=OneWay, TargetNullValue=当前任务}"/>
                                    <Run Text=" · 先看实际交付，需要时再展开证据"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ContinueConversationCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="12,8"
                                        Margin="0,0,8,0"
                                        Click="FocusPrompt_Click">
                                    <TextBlock FontSize="10.5" Foreground="#071014" FontWeight="SemiBold" Text="继续完善"/>
                                </Button>
                                <Button Command="{Binding HideDeliveryCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Padding="11,8"
                                        ToolTip="返回任务执行画面">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="10"
                                              Height="10"
                                              Data="M9,1 L2,5 L9,9"
                                              Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"/>
                                        <TextBlock Margin="7,0,0,0" FontSize="10.5" Text="返回对话"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="12"
                                    Background="#C80D1119"
                                    BorderBrush="#263044"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,2,4,12">
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="交付内容"/>
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="9"
                                                   Foreground="#647087"
                                                   Text="{Binding DeliveryArtifactCount, StringFormat={}{0} 项}"/>
                                    </Grid>

                                     <ListBox Grid.Row="1"
                                             MaxHeight="168"
                                             Margin="0,0,0,10"
                                             ItemsSource="{Binding DeliveryArtifacts}"
                                             SelectedItem="{Binding SelectedArtifact}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ArtifactSurface"
                                                                    Padding="12"
                                                                    Background="#10151F"
                                                                    BorderBrush="#20293A"
                                                                    BorderThickness="1"
                                                                    CornerRadius="11">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ArtifactSurface" Property="Background" Value="#151C29"/>
                                                                    <Setter TargetName="ArtifactSurface" Property="BorderBrush" Value="#35415A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ArtifactSurface" Property="Background" Value="#172334"/>
                                                                    <Setter TargetName="ArtifactSurface" Property="BorderBrush" Value="#75F0FF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3"
                                                            Background="{Binding Accent}"
                                                            CornerRadius="2"/>
                                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                        <Border HorizontalAlignment="Left"
                                                                Padding="6,2"
                                                                Background="#1A2230"
                                                                CornerRadius="5">
                                                            <TextBlock FontSize="8.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Accent}"
                                                                       Text="{Binding Type}"/>
                                                        </Border>
                                                        <TextBlock Margin="0,8,0,0"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="9"
                                                                   Foreground="#737E93"
                                                                   Text="{Binding Subtitle}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Expander Grid.Row="2"
                                              Margin="2,4,2,0"
                                              IsExpanded="{Binding IsDeliveryEvidenceExpanded, Mode=TwoWay}"
                                              Foreground="#AEB8C8">
                                        <Expander.Header>
                                            <Grid Margin="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="证据与运行记录"/>
                                                    <TextBlock Margin="0,3,0,0"
                                                               FontSize="8.5"
                                                               Foreground="#667389"
                                                               Text="默认收起，不打扰接手成果"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Background="#151C27"
                                                        CornerRadius="6">
                                                    <TextBlock FontSize="8.5"
                                                               Foreground="#8190A5"
                                                               Text="{Binding DeliveryEvidenceCount, StringFormat={}{0} 项}"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ListBox ItemsSource="{Binding DeliveryEvidenceArtifacts}"
                                                 SelectedItem="{Binding SelectedArtifact}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="EvidenceSurface"
                                                                        Padding="9,8"
                                                                        Background="#0F141D"
                                                                        BorderBrush="#202838"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="EvidenceSurface" Property="Background" Value="#151B26"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="EvidenceSurface" Property="BorderBrush" Value="#587B82"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Width="38"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Accent}"
                                                                   Text="{Binding Type}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock FontSize="9.5"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="8"
                                                                       Foreground="#68748A"
                                                                       Text="{Binding Subtitle}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="25"
                                    Background="#DD0E121B"
                                    BorderBrush="#293349"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding SelectedArtifactVersion.Accent}"
                                                       Text="{Binding SelectedArtifactVersion.Type}"/>
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedArtifactVersion.Title}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="10.5"
                                                       Foreground="#7D889E"
                                                       Text="{Binding SelectedArtifactVersion.Subtitle}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="9,5"
                                                Background="#12201D"
                                                BorderBrush="#2E5549"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="10"
                                                      Height="10"
                                                      Data="M1,5 L4,8 L9,2"
                                                      Fill="Transparent"
                                                      Stroke="{StaticResource GreenBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"/>
                                                <TextBlock Margin="6,0,0,0"
                                                           FontSize="9"
                                                           Foreground="{StaticResource GreenBrush}"
                                                           Text="已核验"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Height="1"
                                            Margin="0,20,0,18"
                                            Background="#252E40"/>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Padding="1,0,12,0"
                                                   FontSize="12"
                                                   LineHeight="21"
                                                   Foreground="#C2CBDB"
                                                   Text="{Binding SelectedArtifactVersion.Preview}"
                                                   TextWrapping="Wrap"/>
                                    </ScrollViewer>

                                    <Grid Grid.Row="3" Margin="0,18,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="8.5" Foreground="#566176" Text="本地交付"/>
                                                    <Border Margin="7,0,0,0"
                                                            Padding="5,1"
                                                            Background="#17202D"
                                                            CornerRadius="4">
                                                        <TextBlock FontSize="8"
                                                                   Foreground="#8090A9"
                                                                   Text="{Binding SelectedArtifactVersion.VersionLabel}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,5,0,0"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="9.5"
                                                           Foreground="#8290A8"
                                                           Text="{Binding SelectedArtifactVersion.Location}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SelectedArtifactVersion.Location}"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       FontSize="8.5"
                                                       Foreground="#59657A"
                                                       Text="{Binding SelectedArtifactVersion.CreatedLabel}"/>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,15,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding OpenDeliveryWorkspaceCommand}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="10,7"
                                                        Margin="0,0,7,0"
                                                        ToolTip="在文件资源管理器中打开当前任务工作区">
                                                    <TextBlock FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#071014"
                                                               Text="打开工作区"/>
                                                </Button>
                                                <Button Command="{Binding OpenArtifactCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,7"
                                                        Margin="0,0,7,0"
                                                        ToolTip="打开当前交付清单或证据文件">
                                                    <TextBlock FontSize="9.5" Text="打开当前项"/>
                                                </Button>
                                                <Button Command="{Binding CopyArtifactPathCommand}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,7"
                                                        ToolTip="复制本地文件路径">
                                                    <TextBlock FontSize="9.5" Text="复制路径"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
