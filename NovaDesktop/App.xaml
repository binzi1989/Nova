<Application x:Class="NovaDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:NovaDesktop.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
            <infra:TaskStateBrushConverter x:Key="TaskStateBrush"/>
            <infra:TaskStateLabelConverter x:Key="TaskStateLabel"/>
            <infra:ActivityKindBrushConverter x:Key="ActivityKindBrush"/>
            <infra:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility"/>
            <infra:InverseBooleanConverter x:Key="InverseBoolean"/>
            <infra:AgentExecutionModeLabelConverter x:Key="AgentExecutionModeLabel"/>

            <!-- Modern Huaxia palette: 玄墨、月白、玉青、朱砂、鎏金. -->
            <Color x:Key="ColorBackground">#070A12</Color>
            <Color x:Key="ColorSurface">#0B101B</Color>
            <Color x:Key="ColorSurfaceRaised">#101827</Color>
            <Color x:Key="ColorSurfaceHigh">#162238</Color>
            <Color x:Key="ColorBorder">#263653</Color>
            <Color x:Key="ColorText">#F4F7FF</Color>
            <Color x:Key="ColorMuted">#8D9BB2</Color>
            <Color x:Key="ColorCyan">#62E6FF</Color>
            <Color x:Key="ColorViolet">#9A86FF</Color>
            <Color x:Key="ColorGreen">#56D6A9</Color>
            <Color x:Key="ColorAmber">#F4C86A</Color>
            <Color x:Key="ColorCinnabar">#748BFF</Color>
            <Color x:Key="ColorMoonWhite">#F4F7FF</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource ColorSurfaceRaised}"/>
            <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource ColorSurfaceHigh}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}"/>
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}"/>
            <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}"/>
            <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource ColorViolet}"/>
            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ColorGreen}"/>
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource ColorAmber}"/>
            <SolidColorBrush x:Key="CinnabarBrush" Color="{StaticResource ColorCinnabar}"/>
            <SolidColorBrush x:Key="MoonWhiteBrush" Color="{StaticResource ColorMoonWhite}"/>

            <DropShadowEffect x:Key="PanelDepthEffect"
                              BlurRadius="0"
                              ShadowDepth="0"
                              Direction="270"
                              Opacity="0"
                              Color="#000000"/>
            <DropShadowEffect x:Key="ControlDepthEffect"
                              BlurRadius="0"
                              ShadowDepth="0"
                              Direction="270"
                              Opacity="0"
                              Color="#000000"/>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="DisplayTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource MoonWhiteBrush}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <Style x:Key="SealText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#FFF6E8"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="IconText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Background"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#121C2D"/>
                                    <Setter TargetName="Background" Property="BorderBrush" Value="#49648E"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Background" Property="Opacity" Value=".7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.01" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.01" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To=".992" Duration="0:0:0.09"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To=".992" Duration="0:0:0.09"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.006" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.006" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Foreground" Value="#06101B"/>
                <Setter Property="Background" Value="#6BE5FF"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="17,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Background"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#806BE5FF"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Effect="{StaticResource ControlDepthEffect}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#91EDFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Background" Property="Opacity" Value=".75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Background" Property="Opacity" Value=".28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="#101827"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="15,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Background"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Effect="{StaticResource ControlDepthEffect}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Background" Property="Background" Value="#17233A"/>
                                    <Setter TargetName="Background" Property="BorderBrush" Value="#49648E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Background" Property="Opacity" Value=".35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThinProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Background" Value="#202637"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
