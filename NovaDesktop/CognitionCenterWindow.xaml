<Window x:Class="NovaDesktop.CognitionCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NovaDesktop.Controls"
        Title="NOVA 认知中心"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#EEF2FA"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111620"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#293247"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7D879D"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#182131"/>
            <Setter Property="Foreground" Value="#DCE3EF"/>
            <Setter Property="BorderBrush" Value="#34415A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#243149"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5B7199"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#75F0FF"/>
            <Setter Property="Foreground" Value="#071014"/>
            <Setter Property="BorderBrush" Value="#75F0FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1119"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="BorderBrush" Value="#303A51"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="#75F0FF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#141A25"/>
            <Setter Property="Foreground" Value="#E8ECF5"/>
            <Setter Property="BorderBrush" Value="#303A51"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8994AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#75F0FF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#75F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#111721"/>
            <Setter Property="BorderBrush" Value="#273146"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#F5090C13" BorderBrush="#39455D" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#CC10151F" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#1A2436" CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Foreground="#BDA8FF"
                                   Text="&#xE950;"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="认知中心"/>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#778198"
                                   Text="效率总结 · 知识图谱 · 本地长期认知"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="48"
                        Background="Transparent"
                        Foreground="#9AA5B9"
                        BorderThickness="0"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Cursor="Hand"
                        Click="Close_Click"
                        Content="&#xE8BB;"/>
            </Grid>

            <TabControl Grid.Row="1" Margin="18,8,18,18" Background="Transparent" BorderThickness="0">
                <TabItem Header="工作效率总结" IsSelected="True">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="你的工作节奏"/>
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="基于持久任务快照与真实执行日志，不上传个人效率数据。"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="PeriodBox" Width="112" SelectedIndex="0" Margin="0,0,8,0">
                                    <ComboBoxItem Content="最近 7 天" Tag="7"/>
                                    <ComboBoxItem Content="最近 30 天" Tag="30"/>
                                    <ComboBoxItem Content="最近 90 天" Tag="90"/>
                                </ComboBox>
                                <Button Style="{StaticResource ActionButton}" Margin="0" Click="RefreshSummary_Click" Content="刷新总结"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Background="#142333" BorderBrush="#2E5367">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#75F0FF" Text="NOVA 效率指数"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock x:Name="ScoreText" FontSize="31" FontWeight="SemiBold" Text="0"/>
                                        <TextBlock Margin="4,13,0,0" FontSize="11" Foreground="#758097" Text="/ 100"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="完成率"/>
                                    <TextBlock x:Name="CompletionText" Margin="0,10,0,0" FontSize="23" FontWeight="SemiBold" Text="0%"/>
                                    <TextBlock x:Name="CompletedDetailText" Margin="0,5,0,0" FontSize="9" Foreground="#667187" Text="0 / 0 tasks"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="有效专注"/>
                                    <TextBlock x:Name="FocusText" Margin="0,10,0,0" FontSize="23" FontWeight="SemiBold" Text="0 min"/>
                                    <TextBlock x:Name="ActiveDaysText" Margin="0,5,0,0" FontSize="9" Foreground="#667187" Text="0 active days"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="平均周期"/>
                                    <TextBlock x:Name="CycleText" Margin="0,10,0,0" FontSize="23" FontWeight="SemiBold" Text="—"/>
                                    <TextBlock Margin="0,5,0,0" FontSize="9" Foreground="#667187" Text="完成目标的生命周期"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="阻塞目标"/>
                                    <TextBlock x:Name="BlockedText" Margin="0,10,0,0" FontSize="23" FontWeight="SemiBold" Text="0"/>
                                    <TextBlock x:Name="ScheduleText" Margin="0,5,0,0" FontSize="9" Foreground="#667187" Text="0 schedules"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="节奏趋势"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#687389" Text="柱高综合真实活动与有效专注时间"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PeakDayText" HorizontalAlignment="Right" FontSize="10" Foreground="#75F0FF" Text="峰值 —"/>
                                    </Grid>
                                    <controls:ProductivityTrendCanvas x:Name="TrendCanvas" Grid.Row="1" Margin="0,15,0,0" MinHeight="270"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="可执行洞察"/>
                                    <ListBox x:Name="InsightsList"
                                             Grid.Row="1"
                                             Margin="0,13,0,0"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E141E" BorderBrush="#222C3E" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="6" Height="6" Fill="#BDA8FF" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                        <TextBlock Grid.Column="1" FontSize="10" LineHeight="17" Foreground="#A3AEC2" TextWrapping="Wrap" Text="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="SummaryStatusText"
                                               Grid.Row="2"
                                               FontSize="8.8"
                                               Foreground="#5F6A80"
                                               Text="等待生成"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="认知知识图谱">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="长期认知网络"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#687389" Text="目标、项目、概念、Skills、工具与例行任务"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBox x:Name="GraphSearchBox"
                                                 Width="180"
                                                 Margin="0,0,8,0"
                                                 TextChanged="GraphSearchBox_TextChanged"/>
                                        <Button Style="{StaticResource PrimaryButton}" Margin="0" Click="SyncGraph_Click" Content="同步当前认知"/>
                                    </StackPanel>
                                </Grid>
                                <controls:KnowledgeGraphCanvas x:Name="GraphCanvas" Grid.Row="1" Margin="0,13,0,0" MinHeight="470"/>
                                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock FontSize="9" Foreground="#75F0FF" Text="● 目标" Margin="0,0,14,0"/>
                                    <TextBlock FontSize="9" Foreground="#7D8CFF" Text="● 项目" Margin="0,0,14,0"/>
                                    <TextBlock FontSize="9" Foreground="#BDA8FF" Text="● 概念" Margin="0,0,14,0"/>
                                    <TextBlock FontSize="9" Foreground="#6BE5A9" Text="● Skill" Margin="0,0,14,0"/>
                                    <TextBlock FontSize="9" Foreground="#FFC470" Text="● 工具" Margin="0,0,14,0"/>
                                    <TextBlock FontSize="9" Foreground="#F47EFF" Text="● 手动知识"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="认知节点"/>
                                        <TextBlock x:Name="GraphCountText" Margin="0,4,0,0" FontSize="9.5" Foreground="#687389" Text="0 nodes · 0 edges"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="GraphNodeList"
                                         Grid.Row="1"
                                         Margin="0,13,0,12"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0E141E" BorderBrush="#222C3E" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock HorizontalAlignment="Right" FontSize="8.5" Foreground="#75F0FF" Text="{Binding Kind}"/>
                                                    </Grid>
                                                    <TextBlock Margin="0,5,0,0" FontSize="8.8" Foreground="#69758B" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="2" Background="#0D121B" BorderBrush="#242E41" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="添加个人知识"/>
                                        <TextBox x:Name="KnowledgeLabelBox" Margin="0,10,0,0"/>
                                        <TextBox x:Name="KnowledgeDetailBox"
                                                 Margin="0,8,0,0"
                                                 Height="58"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>
                                        <Button Style="{StaticResource ActionButton}" Margin="0,9,0,0" Click="AddKnowledge_Click" Content="连接到所选节点并保存"/>
                                        <TextBlock x:Name="GraphStatusText" Margin="0,8,0,0" FontSize="8.8" Foreground="#667187" TextWrapping="Wrap" Text="所有图谱数据仅保存在本机。"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="本地知识库">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="工作区知识库"/>
                                <TextBlock x:Name="KnowledgeWorkspaceText"
                                           Margin="0,5,0,0"
                                           MaxWidth="700"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="—"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           FontSize="9.5"
                                           Foreground="#667187"
                                           Text="增量更新 · 不上传 · 不执行文件"/>
                                <Button x:Name="IndexKnowledgeButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0"
                                        Click="IndexKnowledge_Click"
                                        Content="索引当前工作区"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="文档"/>
                                    <TextBlock x:Name="KnowledgeDocumentCountText" Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="知识块"/>
                                    <TextBlock x:Name="KnowledgeChunkCountText" Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock FontSize="9.5" Foreground="#758097" Text="源文件体积"/>
                                    <TextBlock x:Name="KnowledgeSizeText" Margin="0,8,0,0" FontSize="23" FontWeight="SemiBold" Text="0 KB"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3"
                                    Margin="0"
                                    Background="#111721"
                                    BorderBrush="#273146"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="13">
                                <Grid>
                                    <TextBox x:Name="KnowledgeSearchBox"
                                             Margin="0,0,100,0"
                                             PreviewKeyDown="KnowledgeSearchBox_PreviewKeyDown"/>
                                    <Button HorizontalAlignment="Right"
                                            Width="92"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0"
                                            Click="SearchKnowledge_Click"
                                            Content="搜索引用"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="引用检索"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#687389" Text="结果包含工作区相对路径、起始行和本地文本片段"/>
                                    </StackPanel>
                                    <ListBox x:Name="KnowledgeResultList"
                                             Grid.Row="1"
                                             Margin="0,13,0,8"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E141E"
                                                        BorderBrush="#222C3E"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="11"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock HorizontalAlignment="Right" FontSize="8.8" Foreground="#75F0FF" Text="{Binding Score, StringFormat=score {0:0.##}}"/>
                                                        </Grid>
                                                        <TextBlock Margin="0,5,0,0"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="8.8"
                                                                   Foreground="#70809A">
                                                            <Run Text="{Binding RelativePath}"/>
                                                            <Run Text=" : "/>
                                                            <Run Text="{Binding StartLine}"/>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,7,0,0"
                                                                   FontSize="9.5"
                                                                   LineHeight="15"
                                                                   Foreground="#A0AABE"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Snippet}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="KnowledgeSearchStatusText"
                                               Grid.Row="2"
                                               FontSize="8.8"
                                               Foreground="#657188"
                                               Text="输入至少两个字符开始检索。"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="已索引文档"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="9.5" Foreground="#687389" Text="单文件上限 1 MB · 工作区上限 50 MB"/>
                                    </StackPanel>
                                    <ListBox x:Name="KnowledgeDocumentList"
                                             Grid.Row="1"
                                             Margin="0,13,0,8"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E141E" BorderBrush="#222C3E" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
                                                    <StackPanel>
                                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,5,0,0"
                                                                   FontSize="8.8"
                                                                   Foreground="#718099"
                                                                   Text="{Binding RelativePath}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="8.5"
                                                                   Foreground="#56647B"
                                                                   Text="{Binding ChunkCount, StringFormat={}{0} chunks}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="KnowledgeLibraryStatusText"
                                               Grid.Row="2"
                                               FontSize="8.8"
                                               Foreground="#657188"
                                               TextWrapping="Wrap"
                                               Text="尚未索引当前工作区。"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
