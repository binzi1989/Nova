<UserControl x:Class="NovaDesktop.Controls.ConversationStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NovaDesktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="920"
             d:DesignHeight="560">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ThreadSpectrum" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#62E6FF" Offset="0"/>
            <GradientStop Color="#748BFF" Offset=".55"/>
            <GradientStop Color="#B17CFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PhaseDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Fill" Value="#4C5D78"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource CyanBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PhasePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From=".35"
                                                 To="1"
                                                 Duration="0:0:0.72"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PhasePulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgentModeCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="154"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Foreground" Value="#E8EEFA"/>
            <Setter Property="Background" Value="#0F1726"/>
            <Setter Property="BorderBrush" Value="#2A3B5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#B5C1D4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="11,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemSurface"
                                            Margin="3,1"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="7">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#18243A"/>
                                            <Setter Property="Foreground" Value="#F4F7FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#1A2C48"/>
                                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ModeToggle"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ModeSurface"
                                                Background="#0F1726"
                                                BorderBrush="#2A3B5A"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid Margin="10,0,9,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      Margin="10,0,0,0"
                                                      Data="M1,1 L4,4 L7,1"
                                                      Fill="Transparent"
                                                      Stroke="#8495AE"
                                                      StrokeThickness="1.25"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ModeSurface" Property="Background" Value="#17233A"/>
                                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#48658F"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#8062E6FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Margin="0,5,0,0"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,5,0,0"
                                        Padding="3"
                                        Background="#FA0D1422"
                                        BorderBrush="#2B3D5D"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity=".3" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeToggle" Property="Opacity" Value=".48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="#1C101827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot" Margin="2,1" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" MinHeight="46" MinWidth="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Background="#526A8D"
                                                        CornerRadius="4"
                                                        Opacity=".82"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#62E6FF"/>
                                                        <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#8B78FF"/>
                                                        <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="34"/>
                                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCardButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,9,9"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#E6111928"/>
            <Setter Property="BorderBrush" Value="#2D405F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChoiceSurface"
                                Padding="14,12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Effect="{StaticResource ControlDepthEffect}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="#F0182740"/>
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource VioletBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Opacity" Value=".78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.012" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.012" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="0,10,0,0"
            Background="#080C13"
            BorderThickness="0"
            CornerRadius="0"
            ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="#080C13"/>
            </Grid.Background>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NOVA's compact cognitive constellation: identity without occupying the conversation. -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        Background="#0B111A"
                        BorderBrush="#273142"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompletedTask}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="34" Height="34">
                            <Ellipse Width="32"
                                     Height="32"
                                     Stroke="#6062E6FF"
                                     StrokeThickness="1"
                                     StrokeDashArray="2 4">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="ConstellationOrbit" CenterX="16" CenterY="16"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="OrbitRun">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:7"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="OrbitRun"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource ThreadSpectrum}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#62E6FF"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="White" Opacity=".9"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="11,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"
                                           Text="NOVA THREADSPACE"/>
                                <Border Margin="8,0,0,0"
                                        Padding="6,1"
                                        Background="#131A24"
                                        BorderThickness="0"
                                        CornerRadius="3">
                                    <TextBlock FontSize="9"
                                               Foreground="#93A5C0"
                                               Text="{Binding ConversationRoundLabel}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#AAB7CB"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="持续推理 · "/>
                                <Run Text="{Binding ExecutionModeDetail, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding ExecutionModes}"
                                      SelectedItem="{Binding SelectedExecutionMode, Mode=TwoWay}"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"
                                      Style="{StaticResource AgentModeCombo}"
                                      Margin="0,0,14,0"
                                      ToolTip="{Binding ExecutionModeDetail}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#D6DCE8"
                                                   Text="{Binding Converter={StaticResource AgentExecutionModeLabel}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Margin="0,0,18,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="8"
                                           Foreground="#59677E"
                                           Text="认知轨迹"/>
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource PhaseDot}"/>
                                    <Ellipse Style="{StaticResource PhaseDot}"/>
                                    <Ellipse Style="{StaticResource PhaseDot}"/>
                                    <Ellipse Style="{StaticResource PhaseDot}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Padding="9,6"
                                    Background="#121B29"
                                    BorderBrush="#29374F"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Margin="0,0,7,0"
                                             Fill="{StaticResource CyanBrush}"/>
                                    <TextBlock FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Text="{Binding CoreStatus}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Goal Mode keeps its observable result contract inside the thread. -->
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="11,9"
                        Background="#D00C1620"
                        BorderBrush="#344760"
                        BorderThickness="1"
                        CornerRadius="11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="{Binding HasGoalMission, Converter={StaticResource BooleanToVisibility}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompletedTask}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="#162B38"
                                    CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="12"
                                           Foreground="{StaticResource CyanBrush}"
                                           Text="&#xE81C;"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="9,0,12,0"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="8"
                                               FontWeight="SemiBold"
                                               Foreground="#6F829E"
                                               Text="MISSION CHARTER"/>
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="8"
                                               Foreground="#596B82"
                                               Text="{Binding GoalMissionMeta}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F2"
                                           Text="{Binding GoalMissionTitle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Padding="8,4"
                                        VerticalAlignment="Center"
                                        Background="#17283A"
                                        BorderBrush="#2F4C65"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}"
                                               Text="{Binding GoalMissionPhase}"/>
                                </Border>
                                <ToggleButton x:Name="MissionDetailsToggle"
                                              Margin="7,0,0,0"
                                              Padding="9,5"
                                              Background="#111A21"
                                              BorderBrush="#334457"
                                              BorderThickness="1"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleSurface"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="ToggleLabel"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#AAB8C9"
                                                               Text="展开契约"/>
                                                    <Path x:Name="ToggleChevron"
                                                          Width="7"
                                                          Height="4"
                                                          Margin="7,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Data="M1,1 L3.5,3.5 L6,1"
                                                          Fill="Transparent"
                                                          Stroke="#7E91A8"
                                                          StrokeThickness="1.1"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleSurface" Property="Background" Value="#1B2830"/>
                                                    <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#4A6275"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleLabel" Property="Text" Value="收起契约"/>
                                                    <Setter TargetName="ToggleChevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" CenterX="3.5" CenterY="2"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="39,9,0,0"
                              Visibility="{Binding IsChecked, ElementName=MissionDetailsToggle, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock MaxHeight="36"
                                       ClipToBounds="True"
                                       FontSize="10.5"
                                       LineHeight="17"
                                       Foreground="#C4CEDD"
                                       Text="{Binding GoalMissionOutcome}"
                                       TextWrapping="Wrap"/>
                            <ScrollViewer Grid.Row="1"
                                          MaxHeight="112"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding GoalSignals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5"
                                                    Padding="8,6"
                                                    Background="#A9101721"
                                                    BorderBrush="#26344A"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="SignalStatusSurface"
                                                            Margin="0,0,9,0"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="#132632"
                                                            CornerRadius="6">
                                                        <TextBlock x:Name="SignalStatusText"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource CyanBrush}"
                                                                   Text="{Binding Status}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#CDD6E5"
                                                                   Text="{Binding Description}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   MaxHeight="28"
                                                                   ClipToBounds="True"
                                                                   FontSize="8.5"
                                                                   LineHeight="14"
                                                                   Foreground="#75849B"
                                                                   Text="{Binding Evidence}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#173229"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="PROVEN">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#173229"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="UNVERIFIED">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#302718"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="PARTIAL">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#302718"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="STALE">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#3A2919"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#351A25"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="#FF7187"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                    <Setter TargetName="SignalStatusSurface" Property="Background" Value="#351A25"/>
                                                    <Setter TargetName="SignalStatusText" Property="Foreground" Value="#FF7187"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,15,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Border Width="1"
                                Margin="39,12,0,12"
                                HorizontalAlignment="Left"
                                Background="#2C4265"
                                Opacity=".72"
                                Visibility="{Binding IsConversationTranscriptVisible, Converter={StaticResource BooleanToVisibility}}"/>

                        <Border MaxWidth="650"
                                Margin="22"
                                Padding="28,25"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#F00D1625"
                                BorderBrush="#38547E"
                                BorderThickness="1"
                                CornerRadius="14"
                                Effect="{StaticResource ControlDepthEffect}"
                                Visibility="{Binding IsCompletedSummaryVisible, Converter={StaticResource BooleanToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42"
                                        Height="42"
                                        VerticalAlignment="Top"
                                        Background="#182A45"
                                        BorderBrush="#4B6FA5"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Foreground="{StaticResource CyanBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               Text="&#xE73E;"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock FontSize="19"
                                               FontWeight="SemiBold"
                                               Text="这一步已经交付"/>
                                    <TextBlock Margin="0,7,0,0"
                                               FontSize="10.5"
                                               LineHeight="17"
                                               Foreground="#94A4BB"
                                               Text="长对话和运行证据已经替你收起。先看实际文件与验证结论，需要追溯时再展开。"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                        <Button Command="{Binding ShowDeliveryCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="13,8">
                                            <TextBlock FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#071014"
                                                       Text="查看本轮交付"/>
                                        </Button>
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding ToggleCompletedConversationCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="11,8">
                                            <TextBlock FontSize="10"
                                                       Text="{Binding CompletedConversationToggleLabel}"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Visibility="{Binding HasConversationTurns, Converter={StaticResource InverseBooleanToVisibility}}">
                            <StackPanel MaxWidth="540"
                                        Margin="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Grid Width="68" Height="68" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#3B4B68" StrokeThickness="1" StrokeDashArray="2 5"/>
                                    <Path Width="30"
                                          Height="30"
                                          Data="M4,16 C8,6 19,4 26,11 C33,18 24,28 14,25 C7,24 1,21 4,16 Z"
                                          Fill="{StaticResource ThreadSpectrum}"
                                          Stretch="Fill"/>
                                </Grid>
                                <TextBlock Margin="0,18,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="{Binding EmptyStateTitle}"/>
                                <TextBlock Margin="0,9,0,0"
                                           TextAlignment="Center"
                                           FontSize="10.5"
                                           LineHeight="17"
                                           Foreground="#79869D"
                                           TextWrapping="Wrap"
                                        Text="{Binding EmptyStateDetail}"/>
                                <Button Margin="0,17,0,0"
                                        Padding="13,7"
                                        HorizontalAlignment="Center"
                                        Command="{Binding UseSuggestionCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                         Content="{Binding SuggestionLabel}"/>
                                <TextBlock Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="8.5"
                                           Foreground="#59667C"
                                           Text="不知道从哪里开始？点击右上角 ? 打开四步引导"/>
                            </StackPanel>
                        </Grid>

                         <ListBox x:Name="ConversationList"
                                  ItemsSource="{Binding ConversationTurns}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.CanContentScroll="False"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  Visibility="{Binding IsConversationTranscriptVisible, Converter={StaticResource BooleanToVisibility}}"
                                  PreviewMouseWheel="ConversationList_PreviewMouseWheel"
                                  PreviewKeyDown="ConversationList_PreviewKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,16"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.24">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="12" To="0" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                         <Border x:Name="MessageShell"
                                                 MaxWidth="1180"
                                                 HorizontalAlignment="Left"
                                                 Padding="14,16"
                                                 Margin="22,0,62,0"
                                                 Background="Transparent"
                                                 BorderBrush="#202A38"
                                                 BorderThickness="0,0,0,1"
                                                 CornerRadius="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="MessageRail"
                                                        Background="{StaticResource ThreadSpectrum}"
                                                        CornerRadius="2"/>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="SpeakerLabel"
                                                                       FontSize="10.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource CyanBrush}"
                                                                       Text="{Binding Speaker}"/>
                                                            <TextBlock Margin="8,0,0,0"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#6C7A92"
                                                                       Text="{Binding TimeLabel}"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="EvidenceLabel"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="8.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#71819A"
                                                                   Text="CONTEXT"/>
                                                    </Grid>
                                                    <controls:MarkdownMessageView Margin="0,12,0,0"
                                                                                  Markdown="{Binding DisplayContent}"/>
                                                    <Border Margin="0,15,0,2"
                                                            Padding="13,12,4,4"
                                                            Background="#D00D1727"
                                                            BorderBrush="#2B4164"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Visibility="{Binding HasChoices, Converter={StaticResource BooleanToVisibility}}">
                                                        <StackPanel>
                                                            <Grid Margin="1,0,10,11">
                                                                <StackPanel>
                                                                    <TextBlock FontSize="9"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource VioletBrush}"
                                                                               Text="选择下一步"/>
                                                                    <TextBlock Margin="0,3,0,0"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#9AA9BF"
                                                                               Text="选一个更合心意的方向，我会把它放进输入框；你还可以接着补充。"/>
                                                                </StackPanel>
                                                                <Border HorizontalAlignment="Right"
                                                                        Padding="8,4"
                                                                        Background="#182543"
                                                                        BorderBrush="#3A578A"
                                                                        BorderThickness="1"
                                                                        CornerRadius="7">
                                                                    <TextBlock FontSize="8.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="#B6C8FF"
                                                                               Text="可交互"/>
                                                                </Border>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Choices}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="2"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource ChoiceCardButton}"
                                                                                Command="{Binding DataContext.SelectConversationChoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="38"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                                                           FontSize="10"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="#6B829E"
                                                                                           Text="{Binding Ordinal}"/>
                                                                                <StackPanel Grid.Column="1">
                                                                                    <TextBlock FontSize="12.5"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#F4F7FC"
                                                                                               Text="{Binding Title}"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Margin="0,5,0,0"
                                                                                               MaxHeight="36"
                                                                                               FontSize="10"
                                                                                               FontWeight="Medium"
                                                                                               LineHeight="16"
                                                                                               Foreground="#93A1B7"
                                                                                               Text="{Binding Description}"
                                                                                               TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Margin="10,0,0,0"
                                                                                           VerticalAlignment="Center"
                                                                                           FontFamily="Segoe Fluent Icons"
                                                                                           FontSize="12"
                                                                                           Foreground="{StaticResource CyanBrush}"
                                                                                           Text="&#xE72A;"/>
                                                                            </Grid>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter TargetName="MessageShell" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="MessageShell" Property="Margin" Value="128,0,10,0"/>
                                            <Setter TargetName="MessageShell" Property="Background" Value="#0D1522"/>
                                            <Setter TargetName="MessageShell" Property="BorderBrush" Value="#2C3A50"/>
                                            <Setter TargetName="MessageShell" Property="CornerRadius" Value="0"/>
                                            <Setter TargetName="MessageRail" Property="Background" Value="{StaticResource VioletBrush}"/>
                                            <Setter TargetName="SpeakerLabel" Property="Foreground" Value="#C8D2FF"/>
                                            <Setter TargetName="EvidenceLabel" Property="Text" Value="YOU"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="system">
                                            <Setter TargetName="MessageShell" Property="HorizontalAlignment" Value="Center"/>
                                            <Setter TargetName="MessageShell" Property="Margin" Value="80,0"/>
                                            <Setter TargetName="MessageShell" Property="Background" Value="#0B111A"/>
                                            <Setter TargetName="MessageShell" Property="BorderBrush" Value="#293445"/>
                                            <Setter TargetName="MessageRail" Property="Background" Value="{StaticResource AmberBrush}"/>
                                            <Setter TargetName="SpeakerLabel" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                            <Setter TargetName="EvidenceLabel" Property="Text" Value="SYSTEM"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Panel.ZIndex="6"
                                    Margin="0,0,18,58"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding HasConversationTurns, Converter={StaticResource BooleanToVisibility}}">
                            <Border Margin="0,0,0,6"
                                    Padding="7,3"
                                    HorizontalAlignment="Center"
                                    Background="#C8131A17"
                                    BorderBrush="#334A42"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock FontSize="8"
                                           Foreground="#81938B"
                                           Text="逐页浏览"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Width="36"
                                        Height="32"
                                        Margin="0,0,6,0"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="回到这轮对话开头"
                                        Click="ScrollTop_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               FontSize="12"
                                               Text="&#xE74A;"/>
                                </Button>
                                <Button Width="36"
                                        Height="32"
                                        Padding="0"
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="回到最新内容"
                                        Click="ScrollLatest_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               FontSize="12"
                                               Text="&#xE74B;"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="NewMessagesButton"
                                Panel.ZIndex="5"
                                Margin="0,0,20,16"
                                Padding="11,6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource SecondaryButton}"
                                Click="NewMessages_Click"
                                Visibility="Collapsed"
                                Content="有新消息 · 回到下方  ↓"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="22,8,40,0"
                            Padding="18,15"
                            Background="#F0111B18"
                            BorderBrush="#6078C8B6"
                            BorderThickness="1,1,1,2"
                            CornerRadius="10,18,18,18"
                            Effect="{StaticResource ControlDepthEffect}"
                            Visibility="{Binding HasStreamingText, Converter={StaticResource BooleanToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource ThreadSpectrum}" CornerRadius="2"/>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}"
                                               Text="NOVA"/>
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="8.5"
                                               Foreground="#7D8C85"
                                               Text="正在斟酌，也在把事情理顺"/>
                                    <Rectangle Width="34"
                                               Height="2"
                                               Margin="10,0,0,0"
                                               RadiusX="1"
                                               RadiusY="1"
                                               Fill="{StaticResource ThreadSpectrum}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Opacity" Value=".35"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="StreamPulse">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From=".25"
                                                                                     To="1"
                                                                                     Duration="0:0:0.82"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="StreamPulse"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           MaxHeight="118"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           LineHeight="21"
                                           Foreground="#E1E7F1"
                                           Text="{Binding StreamingText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Padding="14,11"
                        Background="#F00E1A28"
                        BorderBrush="#365578"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource ControlDepthEffect}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="{Binding HasArtifacts, Converter={StaticResource BooleanToVisibility}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompletedSummaryVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28"
                                Height="28"
                                Background="#172A44"
                                BorderBrush="#3F638C"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource CyanBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Text="&#xE73E;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center">
                            <TextBlock FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}"
                                       Text="本轮成果已进入线程 · 交付状态已同步"/>
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="8.5"
                                       Foreground="#8294AC">
                                <Run Text="{Binding Artifacts.Count, Mode=OneWay}"/>
                                <Run Text=" 个交付物 · 对话不会被切换打断"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Margin="0,0,6,0"
                                    Command="{Binding ToggleCompletedConversationCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="9,6"
                                    Visibility="{Binding IsCompletedConversationExpanded, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock FontSize="9.5" Text="收起对话"/>
                            </Button>
                            <Button Command="{Binding ShowDeliveryCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                     <TextBlock FontSize="9.5" Text="查看本轮交付"/>
                                    <TextBlock Margin="7,0,0,0"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="10"
                                               Text="&#xE72A;"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Approval remains in the same narrative surface instead of replacing the whole page. -->
            <Border Panel.ZIndex="20"
                    MaxWidth="760"
                    MaxHeight="390"
                    Margin="16,0,16,18"
                    Padding="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="#FC0C1422"
                    BorderBrush="#805B78B0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="{Binding IsApprovalVisible, Converter={StaticResource BooleanToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26"
                                      ShadowDepth="0"
                                      Opacity=".3"
                                      Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            Background="#172943"
                            BorderBrush="#385A86"
                            BorderThickness="1"
                            CornerRadius="9"
                            VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource IconText}"
                                   Foreground="{StaticResource CyanBrush}"
                                   Text="&#xE72E;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,16,0">
                        <TextBlock Margin="0,0,0,3"
                                   FontSize="8.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"
                                   Text="执行前确认"/>
                        <TextBlock FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Text="{Binding ApprovalTitle}"/>
                        <ScrollViewer MaxHeight="92"
                                      Margin="0,5,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <TextBlock Padding="0,0,8,0"
                                       FontSize="9.5"
                                       LineHeight="15"
                                       Foreground="#8995AB"
                                       Text="{Binding ApprovalDescription}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                    <Border Grid.Column="2"
                            Padding="8,4"
                            VerticalAlignment="Top"
                            Background="#1A2133"
                            BorderBrush="#374766"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsApprovalPreviewVisible, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AmberBrush}"
                                   Text="{Binding ApprovalStats}"/>
                    </Border>
                    <Border Grid.Row="1"
                            Grid.ColumnSpan="3"
                            MinHeight="96"
                            MaxHeight="150"
                            Margin="0,13,0,0"
                            Background="#080D17"
                            BorderBrush="#263653"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding IsApprovalPreviewVisible, Converter={StaticResource BooleanToVisibility}}">
                        <TextBox Margin="11"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="#B8C3D6"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="9.5"
                                 Text="{Binding ApprovalPreview, Mode=OneWay}"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <Grid Grid.Row="2"
                          Grid.ColumnSpan="3"
                          Margin="0,13,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="8.8"
                                   Foreground="#8293AA"
                                   TextWrapping="Wrap"
                                   Text="{Binding ApprovalSafetyNote}"/>
                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding RejectCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Content="{Binding ApprovalRejectLabel}"
                                    Margin="0,0,6,0"/>
                            <Button Command="{Binding ApproveCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="{Binding ApprovalAllowLabel}"
                                    Margin="0,0,6,0"
                                    Padding="12,7"/>
                            <Button Command="{Binding ApproveForRunCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{Binding ApprovalTrustLabel}"
                                    Padding="12,7"
                                    Visibility="{Binding IsApprovalTrustVisible, Converter={StaticResource BooleanToVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
