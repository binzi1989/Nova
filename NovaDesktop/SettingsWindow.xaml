<Window x:Class="NovaDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA 模型设置"
        Width="520"
        Height="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#20293A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#26374A"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#111722"/>
            <Setter Property="BorderBrush" Value="#2C3549"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                            <Path Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Fill="#778197" Data="M 0 0 L 8 0 L 4 5 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,34,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="#F7181D29"
                                        BorderBrush="#39445A"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity=".6" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="18"
            Background="#F30D1119"
            BorderBrush="#344057"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="8" Color="#000000" Opacity=".7"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="29" Height="29" CornerRadius="9" Background="#1C2638">
                        <TextBlock FontFamily="Segoe Fluent Icons" Foreground="{StaticResource CyanBrush}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE713;"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="模型与运行时"/>
                        <TextBlock FontSize="9" Foreground="#657087" Text="内存模式或 Windows 凭据管理器"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="42" Height="38" Margin="0,0,8,0"
                        Style="{StaticResource GhostButton}" Click="Close_Click">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE8BB;"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,8,24,24">
                <TextBlock FontSize="10" Foreground="#7C869C" Text="OPENAI API KEY"/>
                <Border Margin="0,8,0,0" Background="#111722" BorderBrush="#2C3549" BorderThickness="1" CornerRadius="10" Padding="12,3">
                    <PasswordBox x:Name="ApiKeyBox"
                                 Height="37"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource CyanBrush}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 PasswordChar="●"/>
                </Border>
                <TextBlock x:Name="KeyHint" Margin="2,7,0,0" FontSize="9.5" Foreground="#667188"
                           Text="请输入 sk-...；不会写入设置、日志或任务记录。"/>
                <CheckBox x:Name="RememberKeyBox"
                          Margin="2,12,0,0"
                          Foreground="#AAB5C9"
                          FontSize="10"
                          VerticalContentAlignment="Center"
                          Content="使用 Windows 凭据管理器安全保存（仅当前 Windows 用户）"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="10" Foreground="#7C869C" Text="提供商"/>
                        <Border Margin="0,8,0,0" Background="#111722" BorderBrush="#2C3549" BorderThickness="1" CornerRadius="10" Padding="6,2">
                            <ComboBox x:Name="ProviderBox"
                                      Height="39"
                                      Style="{StaticResource DarkComboBox}"
                                      FontFamily="Segoe UI Variable Text, Segoe UI"
                                      SelectionChanged="ProviderBox_SelectionChanged">
                                <ComboBoxItem Tag="openai" Content="OpenAI"/>
                                <ComboBoxItem Tag="deepseek" Content="DeepSeek"/>
                                <ComboBoxItem Tag="kimi" Content="Kimi · Moonshot AI"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="10" Foreground="#7C869C" Text="模型"/>
                        <Border Margin="0,8,0,0" Background="#111722" BorderBrush="#2C3549" BorderThickness="1" CornerRadius="10" Padding="6,2">
                            <ComboBox x:Name="ModelBox"
                                      Height="39"
                                      Style="{StaticResource DarkComboBox}"
                                      FontFamily="Segoe UI Variable Text, Segoe UI"
                                      SelectionChanged="ModelBox_SelectionChanged"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Margin="0,18,0,0" Background="#111923" BorderBrush="#253247" BorderThickness="1" CornerRadius="11" Padding="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe Fluent Icons" Foreground="{StaticResource GreenBrush}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Text="&#xE72E;"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="本机权限仍由 NOVA 控制"/>
                            <TextBlock Margin="0,4,0,0" FontSize="9.2" Foreground="#738096" TextWrapping="Wrap"
                                       Text="模型可以请求工具，但不能绕过工作区边界。写文件和运行命令会在执行前逐次询问。"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ValidationText" Margin="2,12,0,0" FontSize="9.5" Foreground="#FF708F"/>

                <Grid Margin="0,18,0,0">
                    <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Click="PreviewMode_Click"
                            Content="断开当前模型" FontSize="10.5"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Click="Close_Click" Content="取消" Margin="0,0,8,0"/>
                        <Button x:Name="TestConnectionButton"
                                Style="{StaticResource SecondaryButton}"
                                Click="TestConnection_Click"
                                Content="测试连接"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Content="连接真实模型"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
