<Window x:Class="NovaDesktop.EngineeringCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA Engineering Center"
        Width="1240"
        Height="800"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#C90E131D"/>
            <Setter Property="BorderBrush" Value="#263044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#69758C"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#263044" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="#E5090C12"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Ellipse Fill="#1D75F0FF"/>
                        <Path Width="14"
                              Height="14"
                              Data="M2,12 L5.5,2 H8.5 L12,12 M4,8 H10"
                              Stroke="#75F0FF"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="NOVA ENGINEERING"/>
                    <Border Margin="10,0,0,0"
                            Padding="7,3"
                            Background="#17283A"
                            CornerRadius="5">
                        <TextBlock FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="#75F0FF"
                                   Text="0.6 PREVIEW"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="44"
                        Height="34"
                        Margin="0,7,7,7"
                        Style="{StaticResource GhostButton}"
                        Click="Close_Click"
                        ToolTip="关闭工程中心">
                    <Path Width="12"
                          Height="12"
                          Data="M1,1 L11,11 M11,1 L1,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.35"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,17,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="25"
                                   FontWeight="SemiBold"
                                   Text="专业工程中心"/>
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#6BE5A9" Margin="0,0,7,0"/>
                            <TextBlock x:Name="WorkspaceLabel"
                                       FontSize="10.5"
                                       Foreground="#8490A6"
                                       Text="正在读取工作区…"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="LocalReviewButton"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="LocalReview_Click"
                                Content="本地审查"/>
                        <Button x:Name="CodexReviewButton"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="CodexReview_Click"
                                Content="Codex 审查"/>
                        <Button x:Name="WorktreeButton"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="CreateWorktree_Click"
                                Content="隔离 Worktree"/>
                        <Button x:Name="RecycleWorktreeButton"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="RecycleWorktree_Click"
                                Content="安全回收"/>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="Refresh_Click"
                                Content="刷新证据"/>
                        <Button x:Name="VerifyButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="Verify_Click"
                                Content="运行验证"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="CODEX RUNTIME"/>
                                    <Border HorizontalAlignment="Right"
                                            Padding="7,3"
                                            Background="#151D29"
                                            CornerRadius="6">
                                        <TextBlock x:Name="CodexBadge"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFC470"
                                                   Text="PROBING"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="CodexStatus"
                                           Margin="0,15,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="探测本机运行时"/>
                                <TextBlock x:Name="CodexDetail"
                                           Margin="0,7,0,0"
                                           FontSize="10"
                                           Foreground="#7D899F"
                                           TextWrapping="Wrap"
                                           LineHeight="16"/>
                                <TextBlock x:Name="CodexPath"
                                           Margin="0,10,0,0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="8.5"
                                           Foreground="#536078"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="CodexProbeButton"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,6"
                                        Click="ProbeCodex_Click"
                                        Content="验证 CLI"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Text="WORKSPACE HEALTH"/>
                                <UniformGrid Margin="0,15,0,0" Columns="2">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="BRANCH"/>
                                        <TextBlock x:Name="BranchLabel" Style="{StaticResource MetricValue}" Text="—"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="PROJECTS"/>
                                        <TextBlock x:Name="ProjectCountLabel" Style="{StaticResource MetricValue}" Text="0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="ADDITIONS"/>
                                        <TextBlock x:Name="AdditionsLabel"
                                                   Style="{StaticResource MetricValue}"
                                                   Foreground="#6BE5A9"
                                                   Text="+0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="DELETIONS"/>
                                        <TextBlock x:Name="DeletionsLabel"
                                                   Style="{StaticResource MetricValue}"
                                                   Foreground="#FF8B9E"
                                                   Text="-0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource PanelCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="CHANGED FILES"/>
                                    <TextBlock x:Name="ChangedCountLabel"
                                               HorizontalAlignment="Right"
                                               FontSize="9"
                                               Foreground="#75F0FF"
                                               Text="0 FILES"/>
                                </Grid>
                                <ListBox x:Name="ChangedFilesList"
                                         Grid.Row="1"
                                         Margin="0,11,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="23"
                                                        Height="20"
                                                        Background="#172131"
                                                        CornerRadius="5">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#75F0FF"
                                                               Text="{Binding Status}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="9"
                                                           Foreground="#AAB4C8"
                                                           Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="185"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="NATIVE DIFF REVIEW"/>
                                    <Border Margin="9,0,0,0"
                                            Padding="6,2"
                                            Background="#151D29"
                                            CornerRadius="5">
                                        <TextBlock x:Name="DiffBadge"
                                                   FontSize="8"
                                                   Foreground="#75F0FF"
                                                   Text="LIVE"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Padding="9,5"
                                        Click="CopyDiff_Click"
                                        Content="复制 Diff"/>
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="#090C12"
                                    BorderBrush="#20293A"
                                    BorderThickness="0,1,0,0">
                                <TextBox x:Name="DiffBox"
                                         Margin="14"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#B6C1D4"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="10"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="正在收集 Git 证据…"/>
                            </Border>
                            <Border Grid.Row="2"
                                    Background="#0C1017"
                                    BorderBrush="#20293A"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,14,14">
                                <Grid Margin="14,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="9.5" FontWeight="SemiBold" Text="HUNK REVIEW"/>
                                            <TextBlock x:Name="HunkCountLabel"
                                                       Margin="8,0,0,0"
                                                       FontSize="8.5"
                                                       Foreground="#75F0FF"
                                                       Text="0 HUNKS"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="8,4"
                                                    Margin="0,0,5,0"
                                                    Click="RevertHunks_Click"
                                                    Content="撤销所选"/>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4"
                                                    Click="StageHunks_Click"
                                                    Content="暂存所选"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListBox x:Name="HunkList"
                                             Grid.Row="1"
                                             Margin="0,8,0,0"
                                             SelectionMode="Extended"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="8.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#B8C3D6"
                                                                   Text="{Binding FilePath}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="7.5"
                                                                   Foreground="#637087"
                                                                   Text="{Binding Header}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="8"
                                                               Foreground="#FFC470"
                                                               Text="{Binding ChangeLabel}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="VERIFICATION GATE"/>
                                    <Border HorizontalAlignment="Right"
                                            Padding="7,3"
                                            Background="#151D29"
                                            CornerRadius="6">
                                        <TextBlock x:Name="VerificationBadge"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#8490A6"
                                                   Text="NOT RUN"/>
                                    </Border>
                                </Grid>
                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource MetricLabel}"
                                           Text="RECOMMENDED COMMAND"/>
                                <TextBlock x:Name="VerificationCommandLabel"
                                           Margin="0,6,0,0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="9.5"
                                           Foreground="#BDA8FF"
                                           TextWrapping="Wrap"
                                           Text="—"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="155"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="EVIDENCE LEDGER"/>
                                    <TextBlock x:Name="EvidenceCountLabel"
                                               HorizontalAlignment="Right"
                                               FontSize="8.5"
                                               Foreground="#75F0FF"
                                               Text="0 EVENTS"/>
                                </Grid>
                                <TextBlock x:Name="HealthLabel"
                                           Grid.Row="1"
                                           Margin="0,10,0,0"
                                           FontSize="10"
                                           Foreground="#7D899F"
                                           TextWrapping="Wrap"/>
                                <ListBox x:Name="EvidenceList"
                                         Grid.Row="2"
                                         Margin="0,12,0,0"
                                         Background="#090C12"
                                         BorderBrush="#20293A"
                                         BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="9,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="49"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="8"
                                                               Foreground="#647087"
                                                               Text="{Binding TimeLabel}"/>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="7.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#75F0FF"
                                                               Text="{Binding OutcomeLabel}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Action}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Margin="0,3,0,0"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="8"
                                                               Foreground="#6F7C93"
                                                               Text="{Binding Target}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBox x:Name="VerificationOutputBox"
                                         Grid.Row="3"
                                         Margin="0,12,0,0"
                                         Padding="11"
                                         IsReadOnly="True"
                                         Background="#090C12"
                                         Foreground="#AAB4C8"
                                         BorderBrush="#20293A"
                                         BorderThickness="1"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="9"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="尚未运行验证。NOVA 不会把未经验证的改动标记为完成。"/>
                                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                    <Border Height="1" Background="#222B3B"/>
                                    <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#6BE5A9" Margin="0,0,7,0"/>
                                        <TextBlock FontSize="9"
                                                   Foreground="#6F7C93"
                                                   Text="读取与审查无需授权"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#FFC470" Margin="0,0,7,0"/>
                                        <TextBlock FontSize="9"
                                                   Foreground="#6F7C93"
                                                   Text="写入、命令与外部动作继续受 NOVA 授权"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
