<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.9.0-preview.29</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\ActivityEntry.cs" />
    <Compile Remove="Models\AgentInputAttachment.cs" />
    <Compile Remove="Models\AgentOsModels.cs" />
    <Compile Remove="Models\AgentSupervisorModels.cs" />
    <Compile Remove="Models\TaskFailureModels.cs" />
    <Compile Remove="Models\TaskItem.cs" />
    <Compile Remove="Services\AgentExecutionPolicy.cs" />
    <Compile Remove="Services\AgentOsKernel.cs" />
    <Compile Remove="Services\AgentResourceGovernor.cs" />
    <Compile Remove="Services\AgentRuntimeContracts.cs" />
    <Compile Remove="Services\AgentSupervisorService.cs" />
    <Compile Remove="Services\AgentTaskGraphService.cs" />
    <Compile Remove="Services\NovaProductVersion.cs" />
    <Compile Remove="Services\SideEffectReceiptService.cs" />
    <Compile Remove="Services\TaskFailureService.cs" />
    <Compile Remove="Services\TaskJournalService.cs" />
    <Compile Remove="Services\TaskSnapshotService.cs" />
    <ProjectReference Include="..\Nova.AgentOS\Nova.AgentOS.csproj" />
  </ItemGroup>

</Project>
